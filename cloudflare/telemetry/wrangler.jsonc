{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pkp-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-18",
	"upload_source_maps": true,
	// The app's address (main.go defaultTelemetryAPI): this Worker's own
	// Custom Domain, so every path on the host comes here and anything but
	// POST /v1/usage is answered 404.
	"routes": [{ "pattern": "telemetry.pkpapp.cc", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pkp-telemetry",
			"database_id": "c724b546-ccc0-4df8-a13b-181829f371af",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "LIMITER",
			// Unique within the account: bindings sharing an id share counters.
			"namespace_id": "4208",
			// Per client address and Cloudflare location. An install reports
			// once an hour; this leaves room for many behind one address.
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	}
}
